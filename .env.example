# Public site URL used for canonical links, sitemap and Open Graph
NEXT_PUBLIC_SITE_URL=https://yaronengineering.com

# Optional: where contact form submissions are forwarded (webhook URL).
# When unset, submissions are validated and logged server-side only.
CONTACT_WEBHOOK_URL=

# ---- Knowledge Hub (blog) ----
# Spring Boot API base URL as seen from the Next.js SERVER (SSR / route handlers)
API_URL=http://localhost:8080
# Same API as seen from the browser (only needed if different from API_URL)
NEXT_PUBLIC_API_URL=http://localhost:8080
# Shared secret the backend uses to call POST /api/revalidate after publishing
REVALIDATE_SECRET=change-me-to-a-long-random-string
# Hostname of the public media host in production (for next/image remotePatterns), e.g. api.yaronengineering.com
MEDIA_HOSTNAME=
# Seconds between background refreshes of cached blog pages (revalidation on publish is immediate)
BLOG_REVALIDATE_SECONDS=300
