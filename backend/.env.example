# Database
DATABASE_URL=jdbc:postgresql://localhost:5432/yaron_blog
DATABASE_USERNAME=yaron
DATABASE_PASSWORD=yaron

# Security (required, >= 32 characters)
JWT_SECRET=change-me-to-a-long-random-string-of-at-least-32-chars
JWT_TTL_SECONDS=43200

# First admin (created on first start when no users exist)
ADMIN_EMAIL=admin@yaronengineering.com
ADMIN_PASSWORD=change-me-strong-password
ADMIN_NAME=Administrator

# Frontend origin(s) allowed to call the API
CORS_ALLOWED_ORIGINS=http://localhost:3000

# Media
MEDIA_STORAGE_PATH=./data/media
MEDIA_PUBLIC_BASE_URL=http://localhost:8080
MEDIA_MAX_SIZE_MB=8

# Next.js cache revalidation hook
REVALIDATE_URL=http://localhost:3000/api/revalidate
REVALIDATE_SECRET=change-me-revalidate-secret

# Password reset links point at the Next.js site
FRONTEND_URL=http://localhost:3000
PASSWORD_RESET_TTL_MINUTES=30

# Optional SMTP relay for password reset emails. Leave SMTP_HOST empty to log the links instead.
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_STARTTLS=true
MAIL_FROM=no-reply@yaronengineering.com

# Development only: insert clearly labelled sample articles on first start
SEED_SAMPLE_CONTENT=true

SERVER_PORT=8080
